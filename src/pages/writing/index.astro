---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryList from '../../components/EntryList.astro';
import { getPublicWriting, getPublicNotes, withBase } from '../../lib/content';
const entries = await getPublicWriting();
const notes = await getPublicNotes();
---
<BaseLayout title="Writing" active="Writing" description={entries.length ? 'Technical explanations and reflections on building AI and machine learning systems.' : 'No articles published yet. Explore my current projects.'} noindex={!entries.length}>
  <header class="page-heading"><div class="eyebrow">Articles</div><h1>Writing.</h1>{entries.length > 0 && <p>Longer explanations of technical ideas and work I’ve done.</p>}<div class="link-group">{entries.length > 0 && <a class="text-link" href={withBase('/feed.xml')}>Follow via RSS ↗</a>}{notes.length > 0 && <a class="text-link" href={withBase('/notes/')}>Browse notes ↗</a>}</div></header>
  {entries.length ? <EntryList entries={entries}/> : <div class="empty-state"><span class="empty-mark" aria-hidden="true">✳</span><h2>No articles published yet.</h2><p>You can read about my current projects in the meantime.</p><a class="text-link" href={withBase('/projects/')}>Read about the projects ↗</a></div>}
</BaseLayout>
