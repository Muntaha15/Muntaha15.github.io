---
import BaseLayout from './BaseLayout.astro';
import { withBase, formatDate, readingTime, slugifyTag } from '../lib/content';
import type { MarkdownHeading } from 'astro';
interface Props { title: string; description: string; date: Date; updated?: Date; tags: string[]; collection: 'projects'|'writing'|'notes'; body?: string; headings: MarkdownHeading[]; repo?: string; demo?: string; release?: string; maturity?: string; related?: { title: string; href: string }[] }
const { title, description, date, updated, tags, collection, body='', headings, repo, demo, release, maturity, related=[] } = Astro.props;
const active = collection.charAt(0).toUpperCase()+collection.slice(1);
---
<BaseLayout title={title} description={description} active={active} article>
  <a class="back-link" href={withBase(`/${collection}/`)}>← Back to {collection}</a>
  <article data-pagefind-body>
    <header class="article-header"><div class="eyebrow">{collection === 'projects' ? 'Project walkthrough' : maturity}</div><h1 data-pagefind-meta="title">{title}</h1><p class="description" data-pagefind-meta="description">{description}</p><div class="tag-list">{tags.map(tag => <a href={withBase(`/tags/${slugifyTag(tag)}/`)}>{tag}</a>)}</div><div class="article-meta"><span>{collection === 'projects' ? 'Walkthrough published ' : ''}<time datetime={date.toISOString()}>{formatDate(date)}</time></span><span>{readingTime(body)} min read</span>{updated && <span>Updated {formatDate(updated)}</span>}</div>{repo && <div class="link-group"><a class="text-link" href={repo}>View source on GitHub ↗</a>{release && <a class="text-link" href={release}>View release ↗</a>}{demo && <a class="text-link" href={demo}>Open live demo ↗</a>}</div>}</header>
    <div class="article-layout"><div class="prose"><slot /></div>{headings.some(h=>h.depth===2) && <aside class="toc" data-pagefind-ignore><strong>On this page</strong><ul>{headings.filter(h=>h.depth===2).map(h=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></aside>}</div>
  </article>
  {related.length > 0 && <section class="section" style="margin-top:40px"><div class="section-heading"><h2>Related projects</h2></div><div class="link-group">{related.map(item => <a class="text-link" href={withBase(item.href)}>{item.title} ↗</a>)}</div></section>}
</BaseLayout>
