{
  "name": "muntaha-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview --host 127.0.0.1",
    "verify": "node scripts/verify-markdown.mjs && node scripts/verify-copy-email.mjs && node scripts/verify-build.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.3",
    "katex": "0.18.7",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "overrides": {
    "katex": "$katex"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "cheerio": "1.2.0",
    "pagefind": "1.5.2",
    "typescript": "6.0.3"
  }
}
